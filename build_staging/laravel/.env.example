APP_NAME="Portfolio"
APP_ENV=production
APP_KEY=base64:PLACEHOLDER_KEY
APP_DEBUG=false
APP_URL=https://your-domain.infinityfreeapp.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# -------------------------------------------------------------
# InfinityFree Database Configuration (from vPanel -> MySQL Databases)
# -------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=sqlXXX.infinityfree.com
DB_PORT=3306
DB_DATABASE=epiz_xxxxxxx_portfolio
DB_USERNAME=epiz_xxxxxxx
DB_PASSWORD=your_vpanel_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@your-domain.infinityfreeapp.com"
MAIL_FROM_NAME="${APP_NAME}"
